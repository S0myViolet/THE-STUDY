# THE STUDY — environment
#
# Copy to .env.local (ignored by git). Everything is optional: with none of these
# set, THE STUDY runs entirely on this device (IndexedDB) with deterministic
# review. Restart `next dev` after changing this file.

# ---------------------------------------------------------------------------
# Cloud persistence (Supabase). Both values are public-safe: the anon key can
# only reach rows that row level security allows, i.e. the signed-in user's own.
# Find them in Supabase Dashboard -> Project Settings -> API.
# Leave both unset to stay in local mode. See docs/CLOUD.md and supabase/README.md.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# AI (Anthropic). Server-side only — never exposed to the browser. Model calls
# happen exclusively in src/app/api/ai/[op]/route.ts. Without a key every room
# falls back to its deterministic review and says so quietly.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Model used for evaluation, generation and the Curator. Any current model works;
# the effort parameter is adjusted automatically for models that do not accept it.
# Cost per million tokens (input/output), cheapest last:
#   claude-fable-5-1  $10 / $50   most capable
#   claude-opus-5     $5  / $25
#   claude-sonnet-5   $2  / $10
#   claude-haiku-4-5  $1  / $5    ample for this app's short, rubric-guided tasks
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: a cheaper/faster model for low-effort operations (classification,
# short scripted replies). Defaults to ANTHROPIC_MODEL when unset.
# ANTHROPIC_FAST_MODEL=
